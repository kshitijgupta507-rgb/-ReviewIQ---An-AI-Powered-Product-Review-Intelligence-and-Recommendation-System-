# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Gemini API (for RAG Q&A feature) ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Paths (override defaults from configs/default.yaml if needed) ─────────────
# REVIEWIQ_DATA_DIR=data/
# REVIEWIQ_MODELS_DIR=models/

# ─── MLflow ────────────────────────────────────────────────────────────────────
# MLFLOW_TRACKING_URI=http://localhost:5000   # uncomment if using remote server

# ─── Hardware ──────────────────────────────────────────────────────────────────
# REVIEWIQ_DEVICE=cpu   # set to "cuda" if GPU available; auto-detected by default
